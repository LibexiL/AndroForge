<?xml version="1.0" encoding="utf-8"?>
<!-- App comes up out of the home screen: grows from slightly small, fades in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <scale android:duration="380" android:fromXScale="0.86" android:fromYScale="0.86" android:toXScale="1" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="220" android:fromAlpha="0" android:toAlpha="1" />
</set>
