<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/linear_out_slow_in">
    <translate android:duration="400" android:fromYDelta="14%" android:toYDelta="0" />
    <alpha android:duration="240" android:fromAlpha="0" android:toAlpha="1" />
    <scale android:duration="400" android:fromXScale="0.96" android:fromYScale="0.96" android:toXScale="1" android:toYScale="1"
        android:pivotX="50%" android:pivotY="100%" />
</set>
