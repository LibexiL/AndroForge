<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher pushes forward and dissolves, like flying through it. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:zAdjustment="bottom">
    <scale android:duration="380" android:fromXScale="1" android:fromYScale="1" android:toXScale="1.08" android:toYScale="1.08"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="300" android:fromAlpha="1" android:toAlpha="0" />
</set>
